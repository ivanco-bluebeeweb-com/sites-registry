              "notes": {
                "default": "",
                "title": "Notes",
                "type": "string"
              },
              "created_at": {
                "default": "",
                "title": "Created At",
                "type": "string"
              },
              "updated_at": {
                "default": "",
                "title": "Updated At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "title": "Site",
            "type": "object",
            "x-sdl": "entity"
          }
        },
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/Site"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
