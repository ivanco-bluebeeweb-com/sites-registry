{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.13",
  "app_id": "sites-registry",
  "version": "0.1.0",
  "name": "Sites Registry",
  "description": "A single platform-agnostic catalogue of every site you manage -- domain, name, and platform (WordPress, Shopify, other, or none yet). Add a WordPress site here and it connects live in WordPress Hub in the same step; connect one directly in WordPress Hub and it appears here automatically. One list for sites on any platform, or no platform at all.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "sites:read",
    "sites:write"
  ],
  "tools": [
    {
      "name": "add_site",
      "description": "Register a site in the platform-agnostic Sites Registry. Works for any platform, or none at all. Choosing platform='wordpress' AND supplying url/username/app_password connects it live in WordPress Hub in this same call -- not a separate step.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "site.create"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "domain": {
            "description": "Bare domain, e.g. 'example.com' (scheme/path stripped automatically)",
            "title": "Domain",
            "type": "string"
          },
          "name": {
            "default": "",
            "description": "Display name; defaults to the domain if left blank",
            "title": "Name",
            "type": "string"
          },
          "platform": {
            "default": "none",
            "description": "One of: wordpress, shopify, none, other. 'wordpress' with url/username/app_password provided also connects it live in WordPress Hub in the same call.",
            "title": "Platform",
            "type": "string"
          },
          "notes": {
            "default": "",
            "description": "Optional free-text note about this site",
            "title": "Notes",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for platform='wordpress': full https:// site URL",
            "title": "Url"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for platform='wordpress': WP username",
            "title": "Username"
          },
          "app_password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for platform='wordpress': WP Application Password",
            "title": "App Password"
          }
        },
        "required": [
          "domain"
        ],
        "title": "AddSiteParams",
        "type": "object"
      },
      "return_schema": {
        "description": "One registered site. `connector_app`/`connector_ref` are set only\nwhen a real connector extension (e.g. wp-site-connector) is actually\ndriving this site; a manually-added site with platform=\"none\" or a\nnot-yet-connected platform choice leaves both blank.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Id"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "kind": {
            "default": "",
            "title": "Kind",
            "type": "string"
          },
          "subtitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subtitle"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "status": {
            "default": "manual",
            "title": "Status",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          },
          "domain": {
            "default": "",
            "title": "Domain",
            "type": "string"
          },
          "platform": {
            "default": "none",
            "title": "Platform",
            "type": "string"
          },
          "connector_app": {
            "default": "",
            "title": "Connector App",
            "type": "string"
          },
          "connector_ref": {
            "default": "",
            "title": "Connector Ref",
            "type": "string"
          },
          "notes": {
            "default": "",
            "title": "Notes",
            "type": "string"
          },
          "created_at": {
            "default": "",
            "title": "Created At",
            "type": "string"
          },
          "updated_at": {
